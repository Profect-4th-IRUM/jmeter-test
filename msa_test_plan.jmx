            <hashTree/>
            <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="DeliveryAddress PreProcessor" enabled="true">
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="script">def customerId = vars.get(&quot;customerId&quot;)

if (customerId == null || customerId.isEmpty()) {
    log.error(&quot;customerId 변수가 설정되지 않았습니다!&quot;)
}

def deliveryAddressId = &quot;00000007-0000-7000-8000-&quot; + customerId

vars.put(&quot;delivery-address-id&quot;, deliveryAddressId)
</stringProp>
            </JSR223PreProcessor>
            <hashTree/>
            <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="Order Request" enabled="true">
              <intProp name="HTTPSampler.connect_timeout">3000</intProp>
              <intProp name="HTTPSampler.response_timeout">5000</intProp>
              <stringProp name="HTTPSampler.domain">localhost</stringProp>
              <stringProp name="HTTPSampler.port">8080</stringProp>
              <stringProp name="HTTPSampler.protocol">http</stringProp>
              <stringProp name="HTTPSampler.path">/orders/customer</stringProp>
              <boolProp name="HTTPSampler.follow_redirects">true</boolProp>
              <stringProp name="HTTPSampler.method">POST</stringProp>
              <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
              <boolProp name="HTTPSampler.postBodyRaw">true</boolProp>
              <elementProp name="HTTPsampler.Arguments" elementType="Arguments">
                <collectionProp name="Arguments.arguments">
                  <elementProp name="" elementType="HTTPArgument">
                    <boolProp name="HTTPArgument.always_encode">false</boolProp>
                    <stringProp name="Argument.value">{&#xd;
  &quot;productList&quot;: [&#xd;
    {&#xd;
      &quot;productId&quot;: &quot;${selected-product-id}&quot;,&#xd;
      &quot;optionValueId&quot;: &quot;${selected-option-value-id}&quot;,&#xd;
      &quot;quantity&quot;: 1&#xd;
    },&#xd;
    {&#xd;
      &quot;productId&quot;: &quot;${selected-product-id}&quot;,&#xd;
      &quot;optionValueId&quot;: &quot;${selected-option-value-id}&quot;,&#xd;
      &quot;quantity&quot;: 2&#xd;
    }&#xd;
  ],&#xd;
  &quot;deliveryAddressId&quot;: &quot;${delivery-address-id}&quot;,&#xd;
  &quot;deliveryRequest&quot;: &quot;빠르고 안전하게&quot;,&#xd;
  &quot;couponIdList&quot;: [],&#xd;
  &quot;storeId&quot;: &quot;${selected-store-id}&quot;&#xd;
}</stringProp>
                    <stringProp name="Argument.metadata">=</stringProp>
                  </elementProp>
                </collectionProp>
              </elementProp>
            </HTTPSamplerProxy>
