        <OnceOnlyController guiclass="OnceOnlyControllerGui" testclass="OnceOnlyController" testname="Once Only Controller" enabled="true">
          <stringProp name="TestPlan.comments">For Member Login</stringProp>
        </OnceOnlyController>
        <hashTree>
          <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="Customer Auth Processor" enabled="true">
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="script">def threadNum = ctx.getThreadNum()
def loopNum = vars.getIteration()

// customerId 계산
def customerId = ((threadNum + loopNum) % 5000) + 1
def customerIdPadded = String.format(&quot;%012d&quot;, customerId)

// 바로 email, password 생성
def email = &quot;customer${customerId}@example.com&quot;
def password = &quot;1234&quot;

// JMeter 변수로 저장
vars.put(&quot;customerId&quot;, customerIdPadded.toString())
vars.put(&quot;customer-email&quot;, email)
vars.put(&quot;customer-password&quot;, password)
</stringProp>
            <stringProp name="scriptLanguage">groovy</stringProp>
          </JSR223PreProcessor>
          <hashTree/>
          <JSONPostProcessor guiclass="JSONPostProcessorGui" testclass="JSONPostProcessor" testname="AccessToken Extractor" enabled="true">
            <stringProp name="JSONPostProcessor.referenceNames">accessToken</stringProp>
            <stringProp name="JSONPostProcessor.jsonPathExprs">$.data.accessToken</stringProp>
            <stringProp name="JSONPostProcessor.match_numbers">1</stringProp>
            <stringProp name="JSONPostProcessor.defaultValues">NOT_FOUND</stringProp>
          </JSONPostProcessor>
          <hashTree/>
          <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="Member Login Request" enabled="true">
            <stringProp name="TestPlan.comments">member login</stringProp>
            <intProp name="HTTPSampler.connect_timeout">3000</intProp>
            <intProp name="HTTPSampler.response_timeout">5000</intProp>
            <stringProp name="HTTPSampler.domain">localhost</stringProp>
            <stringProp name="HTTPSampler.port">8080</stringProp>
            <stringProp name="HTTPSampler.protocol">http</stringProp>
            <stringProp name="HTTPSampler.path">auth/login</stringProp>
            <boolProp name="HTTPSampler.follow_redirects">true</boolProp>
            <stringProp name="HTTPSampler.method">POST</stringProp>
            <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
            <boolProp name="HTTPSampler.postBodyRaw">true</boolProp>
            <elementProp name="HTTPsampler.Arguments" elementType="Arguments">
              <collectionProp name="Arguments.arguments">
                <elementProp name="" elementType="HTTPArgument">
                  <boolProp name="HTTPArgument.always_encode">false</boolProp>
                  <stringProp name="Argument.value">{&#xd;
    &quot;email&quot; : &quot;${customer-email}&quot;,&#xd;
    &quot;password&quot; : &quot;${customer-password}&quot;&#xd;
}</stringProp>
                  <stringProp name="Argument.metadata">=</stringProp>
                </elementProp>
              </collectionProp>
            </elementProp>
          </HTTPSamplerProxy>
          <hashTree/>
        </hashTree>
        <LoopController guiclass="LoopControlPanel" testclass="LoopController" testname="Loop Controller" enabled="true">
          <intProp name="LoopController.loops">-1</intProp>
        </LoopController>
        <hashTree>
          <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="ProductId PreProcessor" enabled="true">
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="script">import java.util.Random

def random = new Random()
def totalProducts = 1000
def zipfExponent = 1.0  // 값이 클수록 상위 상품에 더 집중 (0.8~1.5 권장)

// Zipf 분포: 역변환 샘플링 (Inverse Transform Sampling)
def u = random.nextDouble()  // 0.0 ~ 1.0

// Zipf 분포 근사 공식: rank = (1 / u)^(1/s)
// s=1일 때 전형적인 Zipf, s가 작을수록 완만한 분포
def rank = Math.ceil(Math.pow(1.0 / u, 1.0 / zipfExponent)).intValue()

// 범위 보정: 1 ~ totalProducts 사이로 확실히 제한
if (rank &lt; 1) {
    rank = 1
} else if (rank &gt; totalProducts) {
    rank = totalProducts
}

// UUID 형식으로 변환 (rank를 16진수 12자리로)
def productId = String.format(&quot;00000004-0000-7000-8000-%012d&quot;, rank)

// JMeter 변수에 저장
vars.put(&quot;product-id&quot;, productId)
vars.put(&quot;product-rank&quot;, rank.toString())  // 디버깅용

// 로그 출력 (테스트 시 확인용)
log.info(&quot;=== Zipf Product Selection ===&quot;)
log.info(&quot;Random value (u): ${u}&quot;)
log.info(&quot;Calculated rank: ${rank}&quot;)
log.info(&quot;Product ID: ${productId}&quot;)
log.info(&quot;==============================&quot;)
</stringProp>
            <stringProp name="scriptLanguage">groovy</stringProp>
          </JSR223PreProcessor>
          <hashTree/>
          <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="Product Get Request" enabled="true">
